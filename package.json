{
  "name": "meme-maker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p client",
    "start": "npm run build && node server/main.ts",
    "fetch:imgflip": "node scripts/fetch-imgflip.ts",
    "dedupe": "node scripts/dedupe.ts",
    "extract:characters": "node scripts/extract-characters.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p . && tsc -p client --noEmit",
    "test": "node --test \"**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/anton": "^5.3.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
